+    #[test]
+    fn text_objects() {
+        assert_eq!(text("git com|mit -am", "diw"), "git | -am");
+        assert_eq!(text("git com|mit -am", "daw"), "git |-am");
+        assert_eq!(text("git commit a|m", "daw"), "git commi|t"); // no blanks after: before
+        assert_eq!(text("git commit -a|m", "daw"), "git commit |-"); // "-" isn't a blank
+        assert_eq!(text("ls x/y|/z q", "ciWa<esc>"), "ls |a q");
+        assert_eq!(text("echo \"he|llo\" x", "di\""), "echo \"|\" x");
+        assert_eq!(text("echo \"he|llo\" x", "da\""), "echo |x");
+        assert_eq!(text("|echo 'a b' c", "ci'z<esc>"), "echo '|z' c"); // the next quotes
+        assert_eq!(text("f(a, (b|), c)", "di("), "f(a, (|), c)");
+        assert_eq!(text("f(a, (b), |c)", "dib"), "f(|)");
+        assert_eq!(text("f(a, (b), |c)", "da("), "|f"); // "f" stays; the cursor clamps
+        assert_eq!(text("x [a |b] y", "di]"), "x [|] y");
+        assert_eq!(text("${HO|ME}", "ci{X<esc>"), "${|X}");
+        assert_eq!(text("a |b", "di("), "a |b"); // not in parentheses: nothing
+    }
