+        let Some(h) = results.get(selected) else {
+            return Paragraph::new("");
+        };
+        let one_line = |s: &str| s.replace('\n', " ");
+        let mut facts = Vec::new();
+        if let Some(s) = stats {
+            let runs = if s.total == 1 {
+                "run"
+            } else {
+                "runs"
+            };
+            facts.push(format!("{} {runs}", s.total));
+            let avg = Duration::from_nanos(s.average_duration).display().largest_unit();
+            facts.push(format!("avg {avg}"));
+            let exits: Vec<String> =
+                s.exits.iter().map(|(code, n)| format!("{code}\u{d7}{n}")).collect();
+            facts.push(format!("exit {}", exits.join(" ")));
+        }
+        facts.push(h.timestamp.to_offset(settings.timezone.0).display().ymd_hm().to_string());
+        let neighbour = |entry: Option<&History>| {
+            entry.map_or_else(|| "\u{2014}".to_string(), |e| one_line(&e.command))
+        };
+        let before = neighbour(stats.and_then(|s| s.previous.as_ref()));
+        let after = neighbour(stats.and_then(|s| s.next.as_ref()));
+        let dim = Style::default().add_modifier(Modifier::DIM);
+        Paragraph::new(vec![
+            Line::styled(format!(" {}", facts.join(" \u{b7} ")), dim),
+            Line::styled(format!(" before: {before}   after: {after}"), dim),
+        ])
+    }
