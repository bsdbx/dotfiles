+    #[test]
+    fn undo_redo() {
+        assert_eq!(text("git |commit", "dwu"), "git |commit");
+        assert_eq!(text("git |commit", "dwu<c-r>"), "git| ");
+        assert_eq!(text("a |b c", "dwdwuu"), "a |b c");
+        assert_eq!(text("a |b c", "dwdw2u"), "a |b c");
+        // an insert is one undo step, with the change that started it
+        assert_eq!(text("git |commit", "cwpush<esc>u"), "git |commit");
+        assert_eq!(text("git |commit", "Ax<esc>ay<esc>u"), "git commit|x");
+        // an insert that changed nothing is no step
+        assert_eq!(text("a |b", "xi<esc>u"), "a |b");
+        assert_eq!(text("|ab", "u"), "|ab");
+        // cursor moves aren't undone
+        assert_eq!(text("|ab cd", "xwu"), "|ab cd");
+    }
