+//! Vim normal mode for the one-line search query (patched in).
+//!
+//! Counts, the `d` `c` `y` operators with motions and text objects, `f F t T` with `; ,`,
+//! `x X s S r ~ D C Y p P`, undo `u` and redo Ctrl-R, `i a I A /`. List keys (`j k gg G H M L`,
+//! Ctrl-U/D/B/F/N/P) come back as atuin actions, so they take a count too. The search UI
+//! hands a key here when `[keymap.vim-normal]` doesn't bind it, or while a command is pending.
+//! Words are runs of `word_chars` (vim's 'iskeyword'), runs of other non-blanks, or blanks.
+
+use super::cursor::Cursor;
+use super::keybindings::Action;
+use super::keybindings::key::{KeyCodeValue, SingleKey};
+
+/// What the search UI does after a key.
+#[derive(Debug, PartialEq, Eq)]
+pub enum Step {
+    /// The command needs more keys (a count, an operator's motion, `f`'s target …).
+    Pending,
+    /// Finished (the query or the cursor may have changed); normal mode stays.
+    Done,
+    /// Switch to insert mode.
+    Insert,
+    /// Run this atuin action `n` times (list movement).
+    Run(Action, usize),
+    /// Select result row `n`, 0-based (`5G`).
+    Row(usize),
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Op {
+    Delete,
+    Change,
+    Yank,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Find {
+    Forward,      // f
+    Backward,     // F
+    TillForward,  // t
+    TillBackward, // T
+}
+
+impl Find {
+    fn reversed(self) -> Self {
+        match self {
+            Self::Forward => Self::Backward,
+            Self::Backward => Self::Forward,
+            Self::TillForward => Self::TillBackward,
+            Self::TillBackward => Self::TillForward,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+enum Wait {
+    #[default]
+    Command,
+    /// `f F t T`: the character to find.
+    Target(Find),
+    /// `r`: the replacement character.
+    Replace,
+    /// `i` / `a` after an operator: the text object.
+    Object {
+        inner: bool,
+    },
+    /// `g`: `gg`, `ge`, `gE`.
+    G,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Motion {
+    Left,
+    Right,
+    LineStart,
+    FirstNonBlank,
+    LineEnd,
+    Column,
+    WordStart {
+        big: bool,
+    },
+    WordBack {
+        big: bool,
+    },
+    WordEnd {
+        big: bool,
+    },
+    WordEndBack {
+        big: bool,
+    },
+    Find {
+        find: Find,
+        target: char,
+        repeat: bool,
+    },
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Class {
+    Blank,
+    Word,
+    Punct,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Snapshot {
+    text: String,
+    pos: usize,
+}
+
+/// The query as characters, the cursor as a character index.
+struct Line<'a> {
+    chars: Vec<char>,
+    pos: usize,
+    word_chars: &'a str,
+}
+
+impl Line<'_> {
+    fn len(&self) -> usize {
+        self.chars.len()
+    }
+
+    fn text(&self) -> String {
+        self.chars.iter().collect()
+    }
+
+    /// Normal mode: the cursor sits on a character, never past the last one.
+    fn clamp(&mut self) {
+        self.pos = self.pos.min(self.len().saturating_sub(1));
+    }
+
+    fn class(&self, i: usize, big: bool) -> Class {
+        let c = self.chars[i];
+        if c.is_whitespace() {
+            Class::Blank
+        } else if big || self.word_chars.contains(c) {
+            Class::Word
+        } else {
+            Class::Punct
+        }
+    }
+
+    fn blank(&self, i: usize) -> bool {
+        self.chars[i].is_whitespace()
+    }
+
+    fn first_non_blank(&self) -> usize {
+        (0..self.len()).find(|&i| !self.blank(i)).unwrap_or(self.len().saturating_sub(1))
+    }
+
+    /// The run of same-class characters around `i`, as `start..end`.
+    fn run(&self, i: usize, big: bool) -> (usize, usize) {
+        let class = self.class(i, big);
+        let mut start = i;
+        while start > 0 && self.class(start - 1, big) == class {
+            start -= 1;
+        }
+        let mut end = i + 1;
+        while end < self.len() && self.class(end, big) == class {
+            end += 1;
+        }
+        (start, end)
+    }
+
+    /// `w`: the start of the next word, or the line's end.
+    fn word_start(&self, mut i: usize, big: bool) -> usize {
+        let n = self.len();
+        if i >= n {
+            return n;
+        }
+        if !self.blank(i) {
+            i = self.run(i, big).1;
+        }
+        while i < n && self.blank(i) {
+            i += 1;
+        }
+        i
+    }
+
+    /// `b`: the start of this word, or of the previous one when already there.
+    fn word_back(&self, mut i: usize, big: bool) -> usize {
+        if i == 0 {
+            return 0;
+        }
+        i -= 1;
+        while i > 0 && self.blank(i) {
+            i -= 1;
+        }
+        if self.blank(i) {
+            i
+        } else {
+            self.run(i, big).0
+        }
+    }
+
+    /// `e`: the end of this word, or of the next one when already there.
+    fn word_end(&self, mut i: usize, big: bool) -> Option<usize> {
+        let n = self.len();
+        i += 1;
+        while i < n && self.blank(i) {
+            i += 1;
+        }
+        (i < n).then(|| self.run(i, big).1 - 1)
+    }
+
+    /// `ge`: the end of the previous word.
+    fn word_end_back(&self, i: usize, big: bool) -> Option<usize> {
+        let mut i = if self.blank(i) {
+            i
+        } else {
+            self.run(i, big).0.checked_sub(1)?
+        };
+        while self.blank(i) {
+            i = i.checked_sub(1)?;
+        }
+        Some(i)
+    }
+
+    /// `f F t T`: the `count`-th `target` from the cursor.
+    fn find(&self, find: Find, target: char, count: usize, repeat: bool) -> Option<usize> {
+        let at = |i: usize| self.chars[i] == target;
+        match find {
+            Find::Forward | Find::TillForward => {
+                // `;` after `t` skips the target right next to the cursor
+                let skip = usize::from(repeat && find == Find::TillForward);
+                let mut i = self.pos + skip;
+                for _ in 0..count {
+                    i = (i + 1..self.len()).find(|&j| at(j))?;
+                }
+                Some(if find == Find::TillForward {
+                    i - 1
+                } else {
+                    i
+                })
+            }
+            Find::Backward | Find::TillBackward => {
+                let skip = usize::from(repeat && find == Find::TillBackward);
+                let mut i = self.pos.checked_sub(skip)?;
+                for _ in 0..count {
+                    i = (0..i).rev().find(|&j| at(j))?;
+                }
+                Some(if find == Find::TillBackward {
+                    i + 1
+                } else {
+                    i
+                })
+            }
+        }
+    }
+
+    /// `iw aw iW aW`.
+    fn word_object(&self, inner: bool, big: bool) -> (usize, usize) {
+        let (start, end) = self.run(self.pos, big);
+        if inner {
+            return (start, end);
+        }
+        let n = self.len();
+        if self.blank(self.pos) {
+            // the blanks and the word after them
+            return (
+                start,
+                if end < n {
+                    self.run(end, big).1
+                } else {
+                    end
+                },
+            );
+        }
+        if end < n && self.blank(end) {
+            (start, self.run(end, big).1) // the word and the blanks after it
+        } else if start > 0 && self.blank(start - 1) {
+            (self.run(start - 1, big).0, end) // none after: the blanks before it
+        } else {
+            (start, end)
+        }
+    }
+
+    /// `i" a" i' a' i` a``: the quoted string the cursor is in or on, else the next one.
+    fn quote_object(&self, inner: bool, quote: char) -> Option<(usize, usize)> {
+        let quotes: Vec<usize> = (0..self.len())
+            .filter(|&i| self.chars[i] == quote && (i == 0 || self.chars[i - 1] != '\\'))
+            .collect();
+        let (open, close) = if let Some(k) = quotes.iter().position(|&i| i == self.pos) {
+            if k % 2 == 0 {
+                (quotes[k], *quotes.get(k + 1)?)
+            } else {
+                (quotes[k - 1], quotes[k])
+            }
+        } else {
+            let before = quotes.iter().filter(|&&i| i < self.pos).count();
+            if before % 2 == 1 {
+                (quotes[before - 1], *quotes.get(before)?)
+            } else {
+                (*quotes.get(before)?, *quotes.get(before + 1)?)
+            }
+        };
+        if inner {
+            return Some((open + 1, close));
+        }
+        // a": with the blanks after it, or before it when there are none after
+        let mut end = close + 1;
+        while end < self.len() && self.blank(end) {
+            end += 1;
+        }
+        let mut start = open;
+        if end == close + 1 {
+            while start > 0 && self.blank(start - 1) {
+                start -= 1;
+            }
+        }
+        Some((start, end))
+    }
+
+    /// `i( a( i[ a[ i{ a{ i< a<` (and `b` `B`): the innermost pair around the cursor.
+    fn pair_object(&self, inner: bool, open: char, close: char) -> Option<(usize, usize)> {
+        let start = if self.chars[self.pos] == open {
+            self.pos
+        } else {
+            let mut depth = 0usize;
+            let mut i = self.pos;
+            loop {
+                i = i.checked_sub(1)?;
+                if self.chars[i] == close {
+                    depth += 1;
+                } else if self.chars[i] == open {
+                    if depth == 0 {
+                        break i;
+                    }
+                    depth -= 1;
+                }
+            }
+        };
+        let mut depth = 0usize;
+        let end = (start + 1..self.len()).find(|&j| {
+            if self.chars[j] == open {
+                depth += 1;
+            } else if self.chars[j] == close {
+                if depth == 0 {
+                    return true;
+                }
+                depth -= 1;
+            }
+            false
+        })?;
+        Some(if inner {
+            (start + 1, end)
+        } else {
+            (start, end + 1)
+        })
+    }
+}
+
+/// Insert-mode Ctrl-W: delete back to the start of the word before the cursor, as `db` does
+/// (the word classes of normal mode; blanks before the cursor go with the word).
+pub fn delete_word_before(input: &mut Cursor, word_chars: &str) {
+    let line = Line {
+        chars: input.as_str().chars().collect(),
+        pos: input.substring().chars().count(),
+        word_chars,
+    };
+    let start = line.word_back(line.pos, false);
+    let mut chars = line.chars;
+    chars.drain(start..line.pos);
+    input.set(chars.into_iter().collect(), start);
+}
+
+#[derive(Default)]
+pub struct Vim {
+    count: Option<usize>,
+    op: Option<(Op, char)>,
+    op_count: Option<usize>,
+    wait: Wait,
+    /// The keys of the pending command, shown like vim's 'showcmd'.
+    keys: String,
+    last_find: Option<(Find, char)>,
+    /// The unnamed register: what `d c x s y` took, what `p P` put.
+    register: String,
+    undo: Vec<Snapshot>,
+    redo: Vec<Snapshot>,
+    /// Set by `u` and Ctrl-R, which manage the undo stacks themselves.
+    undoing: bool,
+}
+
+const MAX_COUNT: usize = 9999;
+const MAX_UNDO: usize = 100;
+
+impl Vim {
+    /// Whether a command is half-typed (it takes the next key, Esc cancels it).
+    pub fn pending(&self) -> bool {
+        !self.keys.is_empty()
+    }
+
+    /// The pending keys, for display.
+    pub fn showcmd(&self) -> &str {
+        &self.keys
+    }
+
+    /// Insert mode starts: everything typed until Esc is one undo step.
+    pub fn insert_started(&mut self, input: &Cursor) {
+        self.push_undo(Snapshot {
+            text: input.as_str().to_owned(),
+            pos: input.substring().chars().count(),
+        });
+    }
+
+    /// Insert mode ends: one that changed nothing leaves no undo step.
+    pub fn insert_ended(&mut self, input: &Cursor) {
+        if self.undo.last().is_some_and(|s| s.text == input.as_str()) {
+            self.undo.pop();
+        }
+    }
+
+    /// One key in normal mode.
+    pub fn feed(&mut self, key: &SingleKey, input: &mut Cursor, word_chars: &str) -> Step {
+        let mut line = Line {
+            chars: input.as_str().chars().collect(),
+            pos: input.substring().chars().count(),
+            word_chars,
+        };
+        line.clamp();
+        let before = Snapshot {
+            text: line.text(),
+            pos: line.pos,
+        };
+        self.undoing = false;
+        let step = self.key(key, &mut line);
+        let text = line.text();
+        if !self.undoing && (step == Step::Insert || text != before.text) {
+            self.push_undo(before);
+        }
+        if step != Step::Insert {
+            line.clamp();
+        }
+        input.set(text, line.pos);
+        step
+    }
+
+    fn push_undo(&mut self, snapshot: Snapshot) {
+        self.undo.push(snapshot);
+        if self.undo.len() > MAX_UNDO {
+            self.undo.remove(0);
+        }
+        self.redo.clear();
+    }
+
+    fn reset(&mut self) {
+        self.count = None;
+        self.op = None;
+        self.op_count = None;
+        self.wait = Wait::Command;
+        self.keys.clear();
+    }
+
+    /// Cancel the pending command (vim beeps).
+    fn cancel(&mut self) -> Step {
+        self.reset();
+        Step::Done
+    }
+
+    fn total(&self) -> usize {
+        self.count.unwrap_or(1).saturating_mul(self.op_count.unwrap_or(1)).min(MAX_COUNT)
+    }
+
+    fn pending_op(&self) -> Option<Op> {
+        self.op.map(|(op, _)| op)
+    }
+
+    #[allow(clippy::too_many_lines)]
+    fn key(&mut self, key: &SingleKey, line: &mut Line) -> Step {
+        let plain = !key.ctrl && !key.alt && !key.super_key;
+        let ch = match key.code {
+            KeyCodeValue::Char(c) if plain => Some(c),
+            KeyCodeValue::Space if plain => Some(' '),
+            _ => None,
+        };
+
+        // The argument of f F t T, r, a text object, g
+        match self.wait {
+            Wait::Command => {}
+            Wait::Target(find) => {
+                let Some(target) = ch else {
+                    return self.cancel();
+                };
+                self.last_find = Some((find, target));
+                return self.motion(
+                    Motion::Find {
+                        find,
+                        target,
+                        repeat: false,
+                    },
+                    line,
+                );
+            }
+            Wait::Replace => {
+                let Some(with) = ch else {
+                    return self.cancel();
+                };
+                return self.replace(with, line);
+            }
+            Wait::Object { inner } => {
+                let Some(object) = ch else {
+                    return self.cancel();
+                };
+                return self.object(inner, object, line);
+            }
+            Wait::G => {
+                return match ch {
+                    Some('g') if self.op.is_none() => {
+                        let count = self.count;
+                        self.reset();
+                        count.map_or(Step::Run(Action::ScrollToTop, 1), |n| Step::Row(n - 1))
+                    }
+                    Some('e') => self.motion(Motion::WordEndBack { big: false }, line),
+                    Some('E') => self.motion(Motion::WordEndBack { big: true }, line),
+                    _ => self.cancel(),
+                };
+            }
+        }
+
+        if key.ctrl && !key.alt && self.op.is_none() {
+            let n = self.total();
+            let step = match key.code {
+                KeyCodeValue::Char('r') => return self.redo(line),
+                KeyCodeValue::Char('u') => Step::Run(Action::ScrollHalfPageUp, n),
+                KeyCodeValue::Char('d') => Step::Run(Action::ScrollHalfPageDown, n),
+                KeyCodeValue::Char('b') => Step::Run(Action::ScrollPageUp, n),
+                KeyCodeValue::Char('f') => Step::Run(Action::ScrollPageDown, n),
+                KeyCodeValue::Char('n') => Step::Run(Action::SelectNext, n),
+                KeyCodeValue::Char('p') => Step::Run(Action::SelectPrevious, n),
+                _ => Step::Done,
+            };
+            self.reset();
+            return step;
+        }
+        match key.code {
+            KeyCodeValue::Left | KeyCodeValue::Backspace if plain => {
+                return self.motion(Motion::Left, line);
+            }
+            KeyCodeValue::Right if plain => return self.motion(Motion::Right, line),
+            KeyCodeValue::Home if plain => return self.motion(Motion::LineStart, line),
+            KeyCodeValue::End if plain => return self.motion(Motion::LineEnd, line),
+            _ => {}
+        }
+        let Some(c) = ch else {
+            return self.cancel();
+        };
+
+        // A count: 1-9 start it, 0 continues it (else 0 is a motion)
+        let typing_count = if self.op.is_some() {
+            self.op_count
+        } else {
+            self.count
+        };
+        if let Some(digit) = c.to_digit(10)
+            && (digit != 0 || typing_count.is_some())
+        {
+            let next = typing_count.unwrap_or(0).saturating_mul(10).saturating_add(digit as usize);
+            if self.op.is_some() {
+                self.op_count = Some(next.min(MAX_COUNT));
+            } else {
+                self.count = Some(next.min(MAX_COUNT));
+            }
+            self.keys.push(c);
+            return Step::Pending;
+        }
+
+        let motion = match c {
+            'h' => Some(Motion::Left),
+            'l' | ' ' => Some(Motion::Right),
+            '0' => Some(Motion::LineStart),
+            '^' => Some(Motion::FirstNonBlank),
+            '$' => Some(Motion::LineEnd),
+            '|' => Some(Motion::Column),
+            'w' => Some(Motion::WordStart { big: false }),
+            'W' => Some(Motion::WordStart { big: true }),
+            'b' => Some(Motion::WordBack { big: false }),
+            'B' => Some(Motion::WordBack { big: true }),
+            'e' => Some(Motion::WordEnd { big: false }),
+            'E' => Some(Motion::WordEnd { big: true }),
+            ';' | ',' => {
+                let Some((find, target)) = self.last_find else {
+                    return self.cancel();
+                };
+                let find = if c == ',' {
+                    find.reversed()
+                } else {
+                    find
+                };
+                Some(Motion::Find {
+                    find,
+                    target,
+                    repeat: true,
+                })
+            }
+            _ => None,
+        };
+        if let Some(motion) = motion {
+            return self.motion(motion, line);
+        }
+
+        let find = match c {
+            'f' => Some(Find::Forward),
+            'F' => Some(Find::Backward),
+            't' => Some(Find::TillForward),
+            'T' => Some(Find::TillBackward),
+            _ => None,
+        };
+        if let Some(find) = find {
+            self.wait = Wait::Target(find);
+            self.keys.push(c);
+            return Step::Pending;
+        }
+        if c == 'g' {
+            self.wait = Wait::G;
+            self.keys.push(c);
+            return Step::Pending;
+        }
+
+        if let Some((pending, pending_key)) = self.op {
+            // after an operator: the same key again (dd cc yy) or a text object
+            return match c {
+                _ if c == pending_key => {
+                    if pending == Op::Yank {
+                        // yy: the whole line; the cursor stays
+                        self.reset();
+                        self.register = line.text();
+                        return Step::Done;
+                    }
+                    let len = line.len();
+                    self.apply(pending, 0, len, line)
+                }
+                'i' | 'a' => {
+                    self.wait = Wait::Object { inner: c == 'i' };
+                    self.keys.push(c);
+                    Step::Pending
+                }
+                _ => self.cancel(),
+            };
+        }
+        let op = match c {
+            'd' => Some(Op::Delete),
+            'c' => Some(Op::Change),
+            'y' => Some(Op::Yank),
+            _ => None,
+        };
+        if let Some(op) = op {
+            self.op = Some((op, c));
+            self.keys.push(c);
+            return Step::Pending;
+        }
+
+        let n = self.total();
+        let has_count = self.count.is_some();
+        self.reset();
+        match c {
+            // shorthands: x = dl, X = dh, s = cl, D = d$, C = c$, Y = y$ (as in Neovim)
+            'x' | 'X' | 's' | 'D' | 'C' | 'Y' => {
+                let (op, motion) = match c {
+                    'x' => (Op::Delete, Motion::Right),
+                    'X' => (Op::Delete, Motion::Left),
+                    's' => (Op::Change, Motion::Right),
+                    'D' => (Op::Delete, Motion::LineEnd),
+                    'C' => (Op::Change, Motion::LineEnd),
+                    _ => (Op::Yank, Motion::LineEnd),
+                };
+                if c == 's' && line.len() == 0 {
+                    return Step::Insert;
+                }
+                self.op = Some((op, c));
+                self.count = Some(n);
+                self.motion(motion, line)
+            }
+            // S = cc
+            'S' => {
+                let len = line.len();
+                self.apply(Op::Change, 0, len, line)
+            }
+            'r' => {
+                self.count = Some(n);
+                self.wait = Wait::Replace;
+                self.keys.push(c);
+                Step::Pending
+            }
+            '~' => {
+                let end = (line.pos + n).min(line.len());
+                for c in &mut line.chars[line.pos..end] {
+                    *c = if c.is_lowercase() {
+                        c.to_uppercase().next().unwrap_or(*c)
+                    } else {
+                        c.to_lowercase().next().unwrap_or(*c)
+                    };
+                }
+                line.pos = end;
+                Step::Done
+            }
+            'p' | 'P' => {
+                if self.register.is_empty() {
+                    return Step::Done;
+                }
+                let text: Vec<char> = self.register.repeat(n).chars().collect();
+                let at = if c == 'p' && line.len() > 0 {
+                    line.pos + 1
+                } else {
+                    line.pos
+                };
+                let added = text.len();
+                line.chars.splice(at..at, text);
+                line.pos = at + added - 1;
+                Step::Done
+            }
+            'u' => self.undo(n, line),
+            'i' => Step::Insert,
+            'a' => {
+                line.pos = (line.pos + 1).min(line.len());
+                Step::Insert
+            }
+            'I' => {
+                line.pos = if line.len() == 0 {
+                    0
+                } else {
+                    line.first_non_blank()
+                };
+                Step::Insert
+            }
+            'A' => {
+                line.pos = line.len();
+                Step::Insert
+            }
+            // a new search: the query is cleared
+            '/' | '?' => {
+                line.chars.clear();
+                line.pos = 0;
+                Step::Insert
+            }
+            'j' => Step::Run(Action::SelectNext, n),
+            'k' => Step::Run(Action::SelectPrevious, n),
+            'G' if has_count => Step::Row(n - 1),
+            'G' => Step::Run(Action::ScrollToBottom, 1),
+            'H' => Step::Run(Action::ScrollToScreenTop, 1),
+            'M' => Step::Run(Action::ScrollToScreenMiddle, 1),
+            'L' => Step::Run(Action::ScrollToScreenBottom, 1),
+            _ => Step::Done,
+        }
+    }
+
+    /// Where a motion lands and whether an operator includes that character.
+    fn reach(&self, motion: Motion, line: &Line) -> Option<(usize, bool)> {
+        let n = self.total();
+        let len = line.len();
+        let pos = line.pos;
+        let op = self.pending_op();
+        let repeat = |mut at: usize, step: &dyn Fn(usize) -> Option<usize>| {
+            let mut moved = false;
+            for _ in 0..n {
+                match step(at) {
+                    Some(next) if next != at => {
+                        at = next;
+                        moved = true;
+                    }
+                    _ => break,
+                }
+            }
+            moved.then_some(at)
+        };
+        match motion {
+            Motion::Left => (pos > 0).then(|| (pos.saturating_sub(n), false)),
+            Motion::Right => {
+                // with an operator the motion may reach past the last character (x, dl)
+                let last = if op.is_some() {
+                    len
+                } else {
+                    len.saturating_sub(1)
+                };
+                let to = (pos + n).min(last);
+                (to > pos).then_some((to, false))
+            }
+            Motion::LineStart => Some((0, false)),
+            Motion::FirstNonBlank => Some((
+                if len == 0 {
+                    0
+                } else {
+                    line.first_non_blank()
+                },
+                false,
+            )),
+            Motion::LineEnd => {
+                if len == 0 {
+                    Some((0, false))
+                } else {
+                    Some((len - 1, true))
+                }
+            }
+            Motion::Column => {
+                Some(((self.count.unwrap_or(1) - 1).min(len.saturating_sub(1)), false))
+            }
+            Motion::WordStart { big } => {
+                if op == Some(Op::Change) && len > 0 && !line.blank(pos) {
+                    // cw changes to the end of the word, like ce (but stays in this word)
+                    let mut end = line.run(pos, big).1 - 1;
+                    for _ in 1..n {
+                        match line.word_end(end, big) {
+                            Some(next) => end = next,
+                            None => break,
+                        }
+                    }
+                    return Some((end, true));
+                }
+                let to = repeat(pos, &|i| Some(line.word_start(i, big)))?;
+                if op.is_some() {
+                    Some((to, false))
+                } else {
+                    Some((to.min(len.saturating_sub(1)), false))
+                }
+            }
+            Motion::WordBack { big } => {
+                repeat(pos, &|i| Some(line.word_back(i, big))).map(|to| (to, false))
+            }
+            Motion::WordEnd { big } => repeat(pos, &|i| line.word_end(i, big)).map(|to| (to, true)),
+            Motion::WordEndBack { big } => {
+                repeat(pos, &|i| line.word_end_back(i, big)).map(|to| (to, true))
+            }
+            Motion::Find {
+                find,
+                target,
+                repeat: again,
+            } => {
+                if len == 0 {
+                    return None;
+                }
+                let to = line.find(find, target, n, again)?;
+                Some((to, matches!(find, Find::Forward | Find::TillForward)))
+            }
+        }
+    }
+
+    fn motion(&mut self, motion: Motion, line: &mut Line) -> Step {
+        let reach = self.reach(motion, line);
+        let Some(op) = self.pending_op() else {
+            self.reset();
+            if let Some((to, _)) = reach {
+                line.pos = to;
+            }
+            return Step::Done;
+        };
+        let Some((to, inclusive)) = reach else {
+            return self.cancel();
+        };
+        let pos = line.pos;
+        let (start, end) = if to >= pos {
+            (
+                pos,
+                if inclusive {
+                    to + 1
+                } else {
+                    to
+                },
+            )
+        } else {
+            (
+                to,
+                if inclusive {
+                    pos + 1
+                } else {
+                    pos
+                },
+            )
+        };
+        let end = end.min(line.len());
+        self.apply(op, start, end, line)
+    }
+
+    fn object(&mut self, inner: bool, object: char, line: &mut Line) -> Step {
+        let Some(op) = self.pending_op() else {
+            return self.cancel();
+        };
+        if line.len() == 0 {
+            return self.cancel();
+        }
+        let range = match object {
+            'w' => Some(line.word_object(inner, false)),
+            'W' => Some(line.word_object(inner, true)),
+            '"' | '\'' | '`' => line.quote_object(inner, object),
+            '(' | ')' | 'b' => line.pair_object(inner, '(', ')'),
+            '[' | ']' => line.pair_object(inner, '[', ']'),
+            '{' | '}' | 'B' => line.pair_object(inner, '{', '}'),
+            '<' | '>' => line.pair_object(inner, '<', '>'),
+            _ => None,
+        };
+        let Some((start, end)) = range else {
+            return self.cancel();
+        };
+        self.apply(op, start, end, line)
+    }
+
+    fn apply(&mut self, op: Op, start: usize, end: usize, line: &mut Line) -> Step {
+        self.reset();
+        if start < end {
+            self.register = line.chars[start..end].iter().collect();
+        }
+        line.pos = start;
+        match op {
+            Op::Yank => Step::Done,
+            Op::Delete => {
+                line.chars.drain(start..end);
+                Step::Done
+            }
+            Op::Change => {
+                line.chars.drain(start..end);
+                Step::Insert
+            }
+        }
+    }
+
+    fn replace(&mut self, with: char, line: &mut Line) -> Step {
+        let n = self.total();
+        self.reset();
+        if line.pos + n > line.len() {
+            return Step::Done;
+        }
+        for c in &mut line.chars[line.pos..line.pos + n] {
+            *c = with;
+        }
+        line.pos += n - 1;
+        Step::Done
+    }
+
+    fn undo(&mut self, n: usize, line: &mut Line) -> Step {
+        self.undoing = true;
+        for _ in 0..n {
+            let Some(snapshot) = self.undo.pop() else {
+                break;
+            };
+            self.redo.push(Snapshot {
+                text: line.text(),
+                pos: line.pos,
+            });
+            line.chars = snapshot.text.chars().collect();
+            line.pos = snapshot.pos;
+        }
+        Step::Done
+    }
+
+    fn redo(&mut self, line: &mut Line) -> Step {
+        let n = self.total();
+        self.reset();
+        self.undoing = true;
+        for _ in 0..n {
+            let Some(snapshot) = self.redo.pop() else {
+                break;
+            };
+            self.undo.push(Snapshot {
+                text: line.text(),
+                pos: line.pos,
+            });
+            line.chars = snapshot.text.chars().collect();
+            line.pos = snapshot.pos;
+        }
+        Step::Done
+    }
+}
