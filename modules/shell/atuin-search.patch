+    #[test]
+    fn counts_and_list_keys() {
+        assert_eq!(run("|a", "j").1, Step::Run(Action::SelectNext, 1));
+        assert_eq!(run("|a", "5j").1, Step::Run(Action::SelectNext, 5));
+        assert_eq!(run("|a", "12k").1, Step::Run(Action::SelectPrevious, 12));
+        assert_eq!(run("|a", "gg").1, Step::Run(Action::ScrollToTop, 1));
+        assert_eq!(run("|a", "3gg").1, Step::Row(2));
+        assert_eq!(run("|a", "G").1, Step::Run(Action::ScrollToBottom, 1));
+        assert_eq!(run("|a", "10G").1, Step::Row(9));
+        assert_eq!(run("|a", "2").1, Step::Pending);
+        assert_eq!(run("|a", "d").1, Step::Pending);
+        assert_eq!(run("|a", "dj").1, Step::Done); // no lines: cancelled
+        assert_eq!(text("a b |c", "/"), "|");
+        assert_eq!(run("a b |c", "/").1, Step::Insert);
+        assert_eq!(text("|abc", "A"), "abc|");
+        assert_eq!(text("a|bc", "a"), "ab|c");
+        assert_eq!(text("  a|bc", "I"), "  |abc");
+    }
+
+    #[test]
+    fn insert_ctrl_w() {
+        let ctrl_w = |text: &str| {
+            let mut input = Cursor::from(text.to_string());
+            input.end();
+            delete_word_before(&mut input, WORD_CHARS);
+            input.into_inner()
+        };
+        assert_eq!(ctrl_w("git commit -am"), "git commit -");
+        assert_eq!(ctrl_w("git commit -"), "git commit ");
+        assert_eq!(ctrl_w("git commit "), "git ");
+        assert_eq!(ctrl_w("echo привіт"), "echo ");
+        assert_eq!(ctrl_w(""), "");
+    }
+
+    #[test]
+    fn showcmd() {
+        let mut vim = Vim::default();
+        let mut input = Cursor::from("abc".to_string());
+        for k in ["2", "d", "i"] {
+            vim.feed(&key(k), &mut input, WORD_CHARS);
+        }
+        assert_eq!(vim.showcmd(), "2di");
+        assert!(vim.pending());
+        vim.feed(&key("esc"), &mut input, WORD_CHARS);
+        assert!(!vim.pending());
+        assert_eq!(input.as_str(), "abc");
+    }
+}
