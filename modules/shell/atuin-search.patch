+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const WORD_CHARS: &str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\
+        абвгґдеєжзиіїйклмнопрстуфхцчшщьюяАБВГҐДЕЄЖЗИІЇЙКЛМНОПРСТУФХЦЧШЩЬЮЯ";
+
+    fn key(s: &str) -> SingleKey {
+        let (code, ctrl) = match s {
+            "esc" => (KeyCodeValue::Esc, false),
+            "ctrl-r" => (KeyCodeValue::Char('r'), true),
+            " " => (KeyCodeValue::Space, false),
+            _ => (KeyCodeValue::Char(s.chars().next().unwrap()), false),
+        };
+        SingleKey {
+            code,
+            ctrl,
+            alt: false,
+            shift: false,
+            super_key: false,
+        }
+    }
+
+    /// Run `keys` (one char each; `<esc>` and `<c-r>` spelled out) on `text` with the cursor at
+    /// the `|` in it; returns the text with `|` at the cursor, and the last step.
+    fn run(text: &str, keys: &str) -> (String, Step) {
+        let pos = text.find('|').unwrap();
+        let mut input = Cursor::from(String::new());
+        input.set(text.replace('|', ""), text[..pos].chars().count());
+        let mut vim = Vim::default();
+        let mut step = Step::Done;
+        let mut rest = keys;
+        while !rest.is_empty() {
+            let (k, len) = if rest.starts_with("<esc>") {
+                ("esc", 5)
+            } else if rest.starts_with("<c-r>") {
+                ("ctrl-r", 5)
+            } else {
+                let c = rest.chars().next().unwrap();
+                (&rest[..c.len_utf8()], c.len_utf8())
+            };
+            rest = &rest[len..];
+            step = if step == Step::Insert {
+                // typed in insert mode, until <esc>
+                if k == "esc" {
+                    input.left();
+                    vim.insert_ended(&input);
+                    Step::Done
+                } else {
+                    input.insert(k.chars().next().unwrap());
+                    Step::Insert
+                }
+            } else {
+                vim.feed(&key(k), &mut input, WORD_CHARS)
+            };
+        }
+        let mut out = input.as_str().to_owned();
+        out.insert(input.position(), '|');
+        (out, step)
+    }
+
+    fn text(text_with_cursor: &str, keys: &str) -> String {
+        run(text_with_cursor, keys).0
+    }
+
+    #[test]
+    fn motions() {
+        assert_eq!(text("git com|mit -am", "w"), "git commit |-am");
+        assert_eq!(text("git com|mit -am", "W"), "git commit |-am");
+        assert_eq!(text("git commit -a|m", "b"), "git commit -|am");
+        assert_eq!(text("git commit -a|m", "B"), "git commit |-am");
+        assert_eq!(text("g|it commit", "e"), "gi|t commit");
+        assert_eq!(text("gi|t commit", "e"), "git commi|t");
+        assert_eq!(text("git com|mit", "ge"), "gi|t commit");
+        assert_eq!(text("git com|mit", "0"), "|git commit");
+        assert_eq!(text("  git |x", "^"), "  |git x");
+        assert_eq!(text("g|it commit", "$"), "git commi|t");
+        assert_eq!(text("|a b c d", "3w"), "a b c |d");
+        assert_eq!(text("|a b c d", "9w"), "a b c |d"); // stops at the last character
+        assert_eq!(text("|abc", "5l"), "ab|c");
+        assert_eq!(text("ab|c", "h "), "ab|c"); // h, then space (= l)
+        assert_eq!(text("|abcdef", "4|"), "abc|def");
+        assert_eq!(text("echo пр|ивіт світ", "w"), "echo привіт |світ");
+    }
+
+    #[test]
+    fn finds() {
+        assert_eq!(text("|a-b-c-d", "f-"), "a|-b-c-d");
+        assert_eq!(text("|a-b-c-d", "2f-"), "a-b|-c-d");
+        assert_eq!(text("|a-b-c-d", "f-;"), "a-b|-c-d");
+        assert_eq!(text("|a-b-c-d", "f-;,"), "a|-b-c-d");
+        assert_eq!(text("|a-b-c-d", "t-"), "|a-b-c-d"); // the target is next: no move
+        assert_eq!(text("|a-b-c-d", "t-;"), "a-|b-c-d");
+        assert_eq!(text("a-bc|d", "F-"), "a|-bcd");
+        assert_eq!(text("a-bc|d", "T-"), "a-|bcd");
+        assert_eq!(text("a-b-c-|d", "T-"), "a-b-c-|d"); // the target is next: no move
+        assert_eq!(text("|abc", "fz"), "|abc"); // not found: stays
+        assert_eq!(text("|a-b-c", "df-"), "|b-c");
+        assert_eq!(text("|a-b-c", "dt-"), "|-b-c");
+        assert_eq!(text("a-b-|c", "dF-"), "a-b|c");
+        assert_eq!(text("a-b-|c", "dT-"), "a-b-|c");
+    }
+
+    #[test]
+    fn operators() {
+        assert_eq!(text("git |commit -am", "dw"), "git |-am");
+        assert_eq!(text("git |commit -am", "cwpush<esc>"), "git pus|h -am");
+        assert_eq!(text("git co|mmit -am", "cwx<esc>"), "git co|x -am");
+        assert_eq!(text("git |commit -am", "d$"), "git| ");
+        assert_eq!(text("git |commit -am", "D"), "git| ");
+        assert_eq!(text("git |commit -am", "d0"), "|commit -am");
+        assert_eq!(text("git |commit -am", "db"), "|commit -am");
+        assert_eq!(text("git commit |-am", "de"), "git commit| "); // "-" is a word of its own
+        assert_eq!(text("a |b c d", "2dw"), "a |d");
+        assert_eq!(text("a |b c d", "d2w"), "a |d");
+        assert_eq!(text("git |commit", "dd"), "|");
+        assert_eq!(text("git |commit", "ccls<esc>"), "l|s");
+        assert_eq!(text("git |commit", "Sls<esc>"), "l|s");
+        assert_eq!(text("git |commit", "Cx<esc>"), "git |x");
+        assert_eq!(text("ab|cd", "x"), "ab|d");
+        assert_eq!(text("ab|cd", "2x"), "a|b");
+        assert_eq!(text("abc|d", "3x"), "ab|c"); // x at the end: the cursor steps back
+        assert_eq!(text("ab|cd", "X"), "a|cd");
+        assert_eq!(text("ab|cd", "sZ<esc>"), "ab|Zd");
+        assert_eq!(text("git |commit", "dx"), "git |commit"); // unknown motion: cancelled
+        assert_eq!(text("git |commit", "d<esc>x"), "git |ommit"); // Esc cancels the operator
+        assert_eq!(text("|", "x"), "|");
+        assert_eq!(text("|", "sa<esc>"), "|a");
+    }
